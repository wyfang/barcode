{
  "name": "barcode",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "build:desktop": "vite build --base=./",
    "desktop": "npm run build:desktop && electron .",
    "dev": "vite",
    "package:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "jsbarcode": "3.12.3",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workbox-window": "7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "build": {
    "appId": "com.wangyifang.barcode",
    "productName": "欧阳骏条码工作台",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "barcode-windows-x64.exe",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
